{
  "manifest_version": 3,
  "name": "TubeDeck",
  "version": "0.4.0",
  "description": "Independent dual-column scrolling, sticky player, Shorts cleaner, and seamless Auto Picture-in-Picture for YouTube.",

  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://www.youtube.com/*"],

  "background": {
    "service_worker": "background.js"
  },

  "commands": {
    "toggle-pip": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "windows": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Toggle Picture-in-Picture (Global)",
      "global": true
    }
  },

  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "world": "MAIN",
      "js": ["main_world.js"],
      "run_at": "document_start"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    }
  },

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
